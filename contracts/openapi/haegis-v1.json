          }
        },
        "title": "ConfirmBody",
        "type": "object"
      },
      "EditBody": {
        "properties": {
          "content": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "EditBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PromoteRequest": {
        "properties": {
          "to": {
            "description": "Target lifecycle stage: shadow, active, or draft.",
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to"
        ],
        "title": "PromoteRequest",
        "type": "object"
      },
      "SwarmRequest": {
        "description": "Population parameters for one lab experiment.",
        "properties": {
          "connectivity": {
            "default": "normal",
            "title": "Connectivity",
            "type": "string"
          },
          "delegation": {
            "default": "normal",
            "title": "Delegation",
            "type": "string"
          },
          "external_access": {
            "default": "limited",
            "title": "External Access",
            "type": "string"
          },
          "perturbation": {
            "default": "unregistered_shared_resource",
            "title": "Perturbation",
            "type": "string"
          },
          "population": {
            "default": 24,
            "maximum": 200.0,
            "minimum": 3.0,
            "title": "Population",
            "type": "integer"
          },
          "shared_memory": {
            "default": "limited",
            "title": "Shared Memory",
            "type": "string"
          }
        },
        "title": "SwarmRequest",
        "type": "object"
      },
      "TextBody": {
        "properties": {
          "finding_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finding Id"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TextBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
