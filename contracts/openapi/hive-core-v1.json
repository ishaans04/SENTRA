{
  "openapi": "3.1.0",
  "info": {
    "title": "HIVE Core API",
    "summary": "Population-level security analysis for autonomous agent estates.",
    "description": "HIVE compares a declared architecture against observed agent interactions, reports capability compositions the architecture forbids, and evaluates pre-authorised containment actions against the live graph.\n\nThis service runs entirely locally against fictional fixtures. It contacts no external system and all controls are simulated.",
    "version": "1.0.0"
  },
  "paths": {
