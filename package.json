{
  "name": "sentra",
  "version": "0.0.0",
  "private": true,
  "description": "SENTRA: approvals tied to conditions, a gateway that holds and rejects affected agent calls, and dictated recovery you confirm before it runs.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "console:dev": "pnpm --filter @sentra/console dev",
    "console:build": "pnpm --filter @sentra/console build",
    "build": "pnpm run console:build",
    "console:check": "pnpm --filter @sentra/console check",
    "console:test": "pnpm --filter @sentra/console test",
    "console:e2e": "pnpm --filter @sentra/console test:e2e",
    "check": "pnpm run console:check",
    "format:write": "pnpm --filter @sentra/console format:write"
  },
  "keywords": [
    "ai-security",
    "agent-security",
    "multi-agent-systems",
    "ai-agents",
    "llm-security",
    "cybersecurity",
    "threat-detection",
    "prompt-injection",
    "data-exfiltration",
    "graph-analysis",
    "defensive-security",
    "agentic-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishaans04/SENTRA.git"
  },
  "bugs": {
    "url": "https://github.com/ishaans04/SENTRA/issues"
  }
}
