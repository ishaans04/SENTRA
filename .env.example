# Local-only settings. Do not put credentials, production URLs, or real data here.
# Model keys are optional: without them the deterministic grammar interprets everything.
AEGIS_INTERPRETER=chain
GEMINI_API_KEY=
GROQ_API_KEY=
AEGIS_GEMINI_MODEL=gemini-2.5-flash-lite
AEGIS_SESSION_CAP=40
AEGIS_SESSION_IDLE_MINUTES=30
# Development only: the Vite console on 5173 talking to the service on 8765.
AEGIS_CORS_ORIGINS=http://127.0.0.1:5173
